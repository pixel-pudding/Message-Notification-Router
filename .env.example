# Copy this file to .env and fill in your own keys. Never commit .env.
# code/media.py and code/agent.py read these from the environment only --
# no keys are ever hardcoded in source.

# Google AI Studio key, used for:
#   - code/media.py: image OCR/classification (model: gemini-flash-latest)
#   - code/agent.py: the tool-calling reasoning agent (model: gemini-3.1-flash-lite)
# Free tier quotas are per-model and often much lower than you'd expect --
# some pinned models return a hard 0-quota or 404 on a given project. If a
# model you're pointing at is exhausted/unavailable, check
# console.groq.com/settings/billing-equivalent (ai.google.dev/gemini-api/docs/rate-limits)
# or try a different pinned (non-"-latest") model on the same key.
GOOGLE_API_KEY=

# Groq API key, used for Whisper large-v3-turbo audio transcription only
# (code/media.py). No longer used for agent reasoning -- Groq's 100k
# tokens/day free tier proved too small for the tool-calling agent loop.
GROQ_API_KEY=
